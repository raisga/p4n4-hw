# p4n4-hwd settings: install-hwd.sh copies this to /etc/p4n4/hwd.env (root-only, since it
# can hold the MQTT password). Uncomment what differs from the defaults, then
# `sudo systemctl restart p4n4-hwd`. See the tools/hw README for each variable.

# Node id in the MQTT topics (status/<node>/..., sensors/<node>/button); default: hostname
#P4N4_NODE_ID=pi-greenhouse

# Where the services run, and ports that differ from the stacks' defaults
#P4N4_HOST=localhost
#P4N4_PORTS=grafana=3001,ollama=11435

# Services to check (leave out the ones this node doesn't run), and the critical ones
#P4N4_SERVICES=mosquitto,influxdb,node-red,grafana,ollama,p4n4-api,p4n4-dashboard
#P4N4_CRITICAL_SERVICES=mosquitto,influxdb

# p4n4-api, whose /ready is checked first; off for TCP probes only
#P4N4_API_URL=http://localhost:8000

# Broker login, when the broker requires one
#MQTT_USER=hwd
#MQTT_PASSWORD=
